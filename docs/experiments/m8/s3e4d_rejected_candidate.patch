+        evidence_ids: &[Uuid],
+        at: Ts,
+    ) -> Result<Vec<MemoryAction>> {
+        match self {
+            Self::Ordered => {
+                reconcile_logical(conn, logical, file, evidence_ids, at, FILE_PRODUCER_FAMILY)
+            }
+            Self::Captured(plans) => apply_reconciliation(
+                conn,
