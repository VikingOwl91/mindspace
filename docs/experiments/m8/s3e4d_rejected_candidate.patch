+// Compatibility-bound existing-target reconciliation, using the real M6 receiver.
+
+#[test]
+fn reconciliation_capture_is_read_only_and_retains_reuse_memberships() {
+    let w = World::new();
+    let seed = w.record(
+        IngestScope::File,
+        &[("a.md", "SYNTHETIC_A")],
+        &[w.notes],
+        100,
+    );
+    let c = w.store.connection().unwrap();
+    let tx = begin_write(&c, &w.store.revision_state).unwrap();
+    let changes = c.total_changes();
+    let rows = dump(&c, true);
+    c.authorizer(Some(|ctx: AuthContext<'_>| match ctx.action {
+        AuthAction::Insert { .. } | AuthAction::Update { .. } | AuthAction::Delete { .. } => {
+            Authorization::Deny
+        }
+        _ => Authorization::Allow,
+    }))
+    .unwrap();
+    let plan = plan_file_observation(
+        &tx,
+        w.observation(
+            IngestScope::File,
+            &[("a.md", "SYNTHETIC_A")],
+            &[w.notes, w.other, w.other],
+            200,
+        ),
+    )
+    .unwrap();
+    assert_eq!(c.total_changes(), changes);
+    assert_eq!(dump(&c, true), rows);
+    match &plan.reconciliations {
+        FileReconciliations::Captured(plans) => {
+            let recon = plans[&0].as_ref().unwrap();
+            assert_eq!(recon.steps.len(), 1);
+            assert!(
+                matches!(&recon.steps[0], ReconciliationStep::Reuse { memory_id, additions: Some(Ok(ids)), .. } if *memory_id == seed.files[0].actions[0].memory_id && ids == &[w.other])
+            );
+        }
+        FileReconciliations::Ordered => panic!("existing disjoint target must be captured"),
+    }
+    clear_authorizer(&c);
+    let report = apply_file_observation(plan).unwrap();
+    assert!(
+        matches!(&report.files[0].actions[0].action, MemoryActionKind::Reused { spaces_added } if spaces_added == &["other"])
+    );
+    tx.commit().unwrap();
+    drop(c);
+    assert_integrity(&w.store);
+}
+
+#[test]
+fn captured_reconciliation_does_not_select_targets_again_during_apply() {
+    for combined in [false, true] {
+        let w = World::new();
+        w.record(
+            IngestScope::File,
+            &[("a.md", "SYNTHETIC_A")],
+            &[w.notes],
+            100,
+        );
+        let report = with_hook(
+            move |stage, c| {
+                if stage == "after_plan" {
+                    c.authorizer(Some(|ctx: AuthContext<'_>| match ctx.action {
+                        AuthAction::Read {
+                            table_name: "memories",
+                            column_name: "id",
+                        } => Authorization::Deny,
+                        _ => Authorization::Allow,
+                    }))
+                    .map_err(dberr)?;
+                }
+                Ok(())
+            },
+            || {
+                let obs = w.observation(
+                    IngestScope::File,
+                    &[("a.md", "SYNTHETIC_A")],
+                    &[w.notes],
+                    200,
+                );
+                if combined {
+                    w.store.record_files_ingest(obs, None, &|| Ok(()))
+                } else {
+                    w.store.record_observation(obs)
+                }
+            },
+        );
+        clear_authorizer(&w.store.connection().unwrap());
+        let report = report.unwrap();
+        assert!(matches!(
+            report.files[0].actions[0].action,
+            MemoryActionKind::Unchanged
+        ));
+        assert_integrity(&w.store);
+    }
+}
+
+#[test]
+fn new_duplicate_and_repeated_logical_operations_keep_ordered_execution() {
+    let w = World::new();
+    let first = w.record(
+        IngestScope::File,
+        &[("a.md", "SYNTHETIC_A")],
+        &[w.notes],
+        100,
+    );
+    let c = w.store.connection().unwrap();
+    let tx = begin_write(&c, &w.store.revision_state).unwrap();
+    for inputs in [
+        vec![("new.md", "SYNTHETIC_NEW")],
+        vec![("a.md", "SYNTHETIC_A"), ("a.md", "SYNTHETIC_A")],
+        vec![("a.md", "SYNTHETIC_A"), ("new.md", "SYNTHETIC_NEW")],
+    ] {
+        let plan = plan_file_observation(
+            &tx,
+            w.observation(IngestScope::File, &inputs, &[w.notes], 200),
+        )
+        .unwrap();
+        assert!(matches!(plan.reconciliations, FileReconciliations::Ordered));
+    }
+    let classifications = [
+        Plan::Unchanged {
+            location: "one".into(),
+            logical: first.files[0].logical_id,
+            file_idx: 0,
+        },
+        Plan::Unchanged {
+            location: "two".into(),
+            logical: first.files[0].logical_id,
+            file_idx: 1,
+        },
+    ];
+    assert!(matches!(
+        FileReconciliations::capture(&tx, &[], &classifications),
+        FileReconciliations::Ordered
+    ));
+}
