+        let w = World::new();
+        let seed = w.record(
+            IngestScope::File,
+            &[("a.md", "SYNTHETIC_A")],
+            &[w.notes],
+            100,
+        );
+        if space_failure {
+            w.store
+                .retire_memory(seed.files[0].actions[0].memory_id, None, Ts(150))
+                .unwrap();
+        }
+        let before = ledger(&w.store);
+        let rows = dump(&w.store.connection().unwrap(), true);
+        let c = w.store.connection().unwrap();
+        let tx = begin_write(&c, &w.store.revision_state).unwrap();
+        let changes = c.total_changes();
+        c.authorizer(Some(move |ctx: AuthContext<'_>| match ctx.action {
+            AuthAction::Read {
+                table_name: "memories",
+                column_name: "id",
+            } if !space_failure => Authorization::Deny,
+            AuthAction::Read {
+                table_name: "spaces",
+                column_name: "name",
+            } if space_failure => Authorization::Deny,
+            _ => Authorization::Allow,
+        }))
+        .unwrap();
+        let plan = plan_file_observation(
+            &tx,
+            w.observation(
+                IngestScope::File,
+                &[("a.md", "SYNTHETIC_CHANGED")],
+                &[w.notes],
+                200,
+            ),
+        )
+        .unwrap();
+        assert!(
+            matches!(&plan.reconciliations, FileReconciliations::Captured(p) if p[&0].is_err())
+        );
+        assert_eq!(c.total_changes(), changes);
+        clear_authorizer(&c);
+        let error = apply_file_observation(plan).unwrap_err();
+        assert!(
+            matches!(error, Error::Storage(ref s) if s.contains("prohibited")),
+            "{error:?}"
+        );
+        assert!(
+            c.total_changes() > changes,
+            "original session/version effects precede this error"
+        );
+        drop(tx);
+        assert!(c.is_autocommit());
+        drop(c);
+        assert_eq!(ledger(&w.store), before);
+        assert_eq!(dump(&w.store.connection().unwrap(), true), rows);
+        assert_integrity(&w.store);
+    }
+}
+
+fn reconciliation_two_fragment_file(text: &str, spaces: &[Uuid]) -> ObservedFile {
+    crate::ingest::observe_bytes(
+        Path::new("a.md"),
+        format!("# A\n\n{text}\n\n# Z\n\nSYNTHETIC_KEEP\n").into_bytes(),
+        format!("{ROOT}/a.md"),
+        spaces,
+    )
+    .unwrap()
+}
+
+#[test]
+fn captured_membership_error_waits_for_preceding_supersession_and_then_rolls_back() {
+    let w = World::new();
+    let mut seed = w.observation(IngestScope::File, &[], &[w.notes], 100);
+    seed.files.push(reconciliation_two_fragment_file(
+        "SYNTHETIC_OLD",
+        &[w.notes],
+    ));
+    w.store.record_observation(seed).unwrap();
+    let before = ledger(&w.store);
+    let rows = dump(&w.store.connection().unwrap(), true);
+    let c = w.store.connection().unwrap();
+    let tx = begin_write(&c, &w.store.revision_state).unwrap();
+    let reads = Arc::new(AtomicUsize::new(0));
+    let count = Arc::clone(&reads);
+    c.authorizer(Some(move |ctx: AuthContext<'_>| match ctx.action {
+        AuthAction::Read {
+            table_name: "memory_spaces",
+            column_name: "space_id",
+        } if count.fetch_add(1, AtomicOrdering::SeqCst) == 1 => Authorization::Deny,
+        _ => Authorization::Allow,
+    }))
+    .unwrap();
+    let mut input = w.observation(IngestScope::File, &[], &[w.notes], 200);
+    input.files.push(reconciliation_two_fragment_file(
+        "SYNTHETIC_NEW",
+        &[w.notes, w.other],
+    ));
+    let changes = c.total_changes();
+    let plan = plan_file_observation(&tx, input).unwrap();
+    match &plan.reconciliations {
+        FileReconciliations::Captured(plans) => {
+            let recon = plans[&0].as_ref().unwrap();
+            assert!(matches!(
+                recon.steps[0],
+                ReconciliationStep::Supersede { .. }
+            ));
+            assert!(matches!(
+                &recon.steps[1],
+                ReconciliationStep::Reuse {
+                    additions: Some(Err(_)),
+                    ..
+                }
+            ));
+        }
+        FileReconciliations::Ordered => panic!("must capture unique existing target"),
+    }
+    assert_eq!(c.total_changes(), changes);
+    clear_authorizer(&c);
+    let error = apply_file_observation(plan).unwrap_err();
+    assert!(
+        matches!(error, Error::Storage(ref s) if s.contains("prohibited")),
+        "{error:?}"
+    );
+    assert_eq!(
+        c.query_row(
+            "SELECT COUNT(*) FROM memories WHERE state='superseded'",
+            [],
+            |r| r.get::<_, i64>(0)
+        )
+        .unwrap(),
+        1,
+        "earlier genuine action executed before deferred error"
+    );
+    assert_eq!(
+        c.query_row("SELECT COUNT(*) FROM memories", [], |r| r.get::<_, i64>(0))
+            .unwrap(),
+        3
+    );
+    drop(tx);
+    assert!(c.is_autocommit());
+    drop(c);
+    assert_eq!(ledger(&w.store), before);
+    assert_eq!(dump(&w.store.connection().unwrap(), true), rows);
+    assert_integrity(&w.store);
+}
