+impl FileReconciliations {
+    fn capture(conn: &Connection, files: &[ObservedFile], plans: &[Plan]) -> Self {
+        let mut locations = HashSet::new();
+        let mut logicals = HashSet::new();
+        for plan in plans {
+            let (location, logical) = match plan {
+                Plan::Unchanged {
+                    location, logical, ..
+                }
+                | Plan::Changed {
+                    location, logical, ..
+                }
+                | Plan::Continue {
+                    location, logical, ..
+                } => (location, logical),
+                Plan::Created { .. } => return Self::Ordered,
+            };
+            if !locations.insert(location) || !logicals.insert(*logical) {
+                return Self::Ordered;
+            }
